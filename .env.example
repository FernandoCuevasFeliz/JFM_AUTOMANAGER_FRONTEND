# URL base de la API del backend (incluye el prefijo de version)
VITE_API_URL=http://localhost:3000/api/v1

# --- ImageKit.io (subida de imagenes de vehiculos) ---------------------------
# Clave publica de tu cuenta de ImageKit. Es publica por diseno.
VITE_IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxxxxx

# URL base para entregar las imagenes (ImageKit URL-endpoint).
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/tu_cuenta

# Endpoint que FIRMA las subidas. Debe devolver { signature, expire, token }
# generados con la clave PRIVADA de ImageKit.
#
# El backend de JFM AutoManager NO expone este endpoint a proposito: no recibe
# archivos, solo guarda la URL resultante (ver "Notas para desarrollo" en
# API.md). Hay que hospedarlo aparte (una funcion serverless basta).
#
# Si lo dejas vacio, el uploader de vehiculos cae automaticamente al modo
# "pegar URL": se sigue pudiendo registrar imagenes escribiendo su URL a mano.
VITE_IMAGEKIT_AUTH_ENDPOINT=
