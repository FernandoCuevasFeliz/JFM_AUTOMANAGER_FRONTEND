# URL base de la API del backend (incluye el prefijo de version)
VITE_API_URL=http://localhost:3000/api/v1

# --- ImageKit.io (subida de imagenes de vehiculos) ---------------------------
# Clave publica de tu cuenta de ImageKit. Es publica por diseno.
# Puedes dejarla vacia si el endpoint de firma ya la devuelve (el del backend
# la incluye cuando defines IMAGEKIT_PUBLIC_KEY alli).
VITE_IMAGEKIT_PUBLIC_KEY=

# URL base para entregar las imagenes (ImageKit URL-endpoint).
VITE_IMAGEKIT_URL_ENDPOINT=
# Endpoint que FIRMA las subidas. Devuelve { signature, expire, token }
# calculados con la clave PRIVADA de ImageKit, que jamas debe llegar al
# navegador. Admite dos formas:
#
#   1. Ruta del propio backend (recomendado). Empieza por "/" y se pide con el
#      token de sesion, porque la ruta exige el permiso vehicles:write.
#      Requiere IMAGEKIT_PRIVATE_KEY en el .env del BACKEND.
#
#        VITE_IMAGEKIT_AUTH_ENDPOINT=/uploads/imagekit-auth
#
#   2. URL absoluta de un servicio externo (una funcion serverless). Se pide
#      sin el token de sesion, asi que debe protegerse por su cuenta.
#
#        VITE_IMAGEKIT_AUTH_ENDPOINT=https://firma.midominio.com/auth
#
# Si lo dejas vacio, el uploader cae automaticamente al modo "pegar URL": se
# siguen registrando imagenes escribiendo su URL a mano.
VITE_IMAGEKIT_AUTH_ENDPOINT=/uploads/imagekit-auth

# --- Facturacion -------------------------------------------------------------
# El NCF y el ciclo fiscal los gobierna el backend (/invoices). Lo que queda
# aqui es lo que la API no modela: la identidad del emisor y el desglose de
# impuesto del impreso. Todo es opcional: lo que se deje vacio no se imprime.

VITE_COMPANY_NAME=EJGH AUTO IMPORT SRL
VITE_COMPANY_RNC=
VITE_COMPANY_ADDRESS=
VITE_COMPANY_CITY=Republica Dominicana
VITE_COMPANY_PHONE=
VITE_COMPANY_EMAIL=
VITE_COMPANY_WEBSITE=

# Tasa de impuesto en tanto por uno: 0.18 = 18 %. En 0 (por defecto) no se
# imprime la linea de impuesto, porque la API guarda un precio de venta cerrado
# y sin desglose fiscal.
VITE_INVOICE_TAX_RATE=0
VITE_INVOICE_TAX_LABEL=ITBIS
# true  = el precio de venta YA incluye el impuesto y la factura lo desglosa.
# false = el impuesto se suma por encima del precio de venta.
VITE_INVOICE_TAX_INCLUDED=true

VITE_INVOICE_FOOTER_NOTE=
